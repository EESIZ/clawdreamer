[Unit]
Description=Flush session memory via /new command
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
Environment=TZ=Asia/Seoul
Environment=OPENCLAW_HOME=/home/YOUR_USER/.openclaw
Environment=DREAMER_HOME=/home/YOUR_USER/.dreamer
ExecStart=/path/to/dreamer/session-flush.sh
StandardOutput=append:/home/YOUR_USER/.dreamer/dream-log/cron.log
StandardError=append:/home/YOUR_USER/.dreamer/dream-log/cron.log
